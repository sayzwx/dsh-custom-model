{
  "name": "dsh-custom-model",
  "version": "1.0.0",
  "description": "Adds a custom-model console and a model probe to the DeepSeek Harness Models settings page: manage hand-declared llm-pi-ai providers in one list, ask an endpoint which models it serves, and probe which of them actually answer, their real context window, max output and the reasoning levels the endpoint accepts.",
  "license": "MIT",
  "author": "石岩",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/probe-core.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayzwx/dsh-custom-model.git"
  },
  "homepage": "https://github.com/sayzwx/dsh-custom-model#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "custom-model",
    "model-probe",
    "llm-pi-ai",
    "provider",
    "model-settings"
  ]
}
